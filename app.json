{
  "expo": {
    "name": "Croqu'Vite",
    "slug": "croquvite",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141820"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.nextgen.croquvite",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à scanner les codes-barres de vos produits."
      }
    },
    "android": {
      "package": "fr.nextgen.croquvite",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "name": "Croqu'Vite",
      "shortName": "Croqu'Vite",
      "display": "standalone",
      "backgroundColor": "#141820",
      "themeColor": "#f97316"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner les codes-barres de vos produits."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "f937ba4b-525c-46cd-bae5-dbcc68662b39"
      }
    }
  }
}