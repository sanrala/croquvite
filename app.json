{
  "expo": {
    "name": "Croqu'Vite",
    "slug": "croquvite",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.nextgen.croquvite",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à scanner les codes-barres de vos produits."
      }
    },
    "android": {
      "package": "fr.nextgen.croquvite",
      "permissions": ["CAMERA", "POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"]
    },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "La caméra sert à scanner les codes-barres de vos produits." }
      ],
      "expo-notifications"
    ]
  }
}
